# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# Java / JVM
*.class
*.log
hs_err_pid*
replay_pid*

# IntelliJ IDEA (only the shared plugin list, formatter switch and inspection settings are committed)
.idea/*
!.idea/externalDependencies.xml
!.idea/palantir-java-format.xml
!.idea/inspectionProfiles/
.idea/inspectionProfiles/*
!.idea/inspectionProfiles/Project_Default.xml
*.iml
*.ipr
*.iws
out/
!**/src/main/**/out/
!**/src/test/**/out/

# Eclipse / VS Code (Java extension)
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/
bin/
!**/src/main/**/bin/
!**/src/test/**/bin/

# VS Code (only the shared extension list and settings are committed)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# NetBeans
nbproject/private/
nbbuild/
dist/
nbdist/
.nb-gradle/

# OS
.DS_Store
Thumbs.db

