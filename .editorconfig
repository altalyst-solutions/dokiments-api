# Shared editor settings. IntelliJ, VS Code and ktlint (via Spotless) all read this.
# ktlint's own style setting lives in build.gradle.kts, because editors don't recognise it.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf
