# Local development settings.
#
# Copy this file to .env and change only what you need: `cp .env.example .env`.
# .env is git-ignored, so your values stay on your machine. Every value below is the default
# that applies when .env doesn't exist or doesn't set it.
#
# Docker Compose reads .env automatically, and the `dev` profile (./gradlew bootRun) reads it
# too, so one file covers both. Deployed containers never read it: they get their settings
# from the platform.
#
# Format: one KEY=value per line, without quotes and without comments on the same line,
# because both Docker Compose and Spring Boot read this file.
#
# Don't put secrets here. Credentials come from your own login (for example gcloud) or the
# platform, never from a file in the project folder.

# Port of the API when running ./gradlew bootRun.
PORT=8080

# Host port of the API container, when running docker compose --profile full.
API_PORT=8080

# Ports of the local Firebase emulators. Each is the same inside the container and on your
# machine, because the Emulator UI connects to them from the browser.
FIRESTORE_EMULATOR_PORT=8085
AUTH_EMULATOR_PORT=9099
# The Emulator UI, to browse and edit local data: http://localhost:4000
EMULATOR_UI_PORT=4000
# Live updates on the UI's Firestore page, and the log stream on its Logs page.
FIRESTORE_WEBSOCKET_PORT=9150
EMULATOR_LOGS_PORT=4500

# How often the Firebase emulators save local data, in seconds. Lower means less is lost if
# Docker is stopped abruptly.
FIRESTORE_SAVE_INTERVAL_SECONDS=60

# How many emulator saves to keep. At least 1.
FIRESTORE_KEEP_SAVES=3

# Redis to use instead of the one Docker Compose starts. Spring Boot finds the Compose Redis
# by itself, so this is only needed for a different Redis.
# REDIS_URL=redis://localhost:6379

# The web app's address, for the links in emails. Locally, the Next.js dev server.
# SITE_URL=http://localhost:3000

# Email. Nothing is sent without RESEND_API_KEY, which is a secret: never put it in this file,
# set it in your shell for one run instead (RESEND_API_KEY=re_... ./gradlew bootRun). Even then,
# locally only these comma-separated addresses receive email. Resend's test address
# delivered@resend.dev is always safe.
# EMAIL_ALLOW_LIST=you@example.com,delivered@resend.dev

# Google sign-in, with an OAuth client for local development whose redirect addresses include
# <SITE_URL>/api/auth/google/callback. The client ID isn't a secret and can go here. Its secret
# is: set it in your shell for one run (GOOGLE_CLIENT_SECRET=... ./gradlew bootRun). Without
# both, Google sign-in sends you back to /sign-in?error=google_failed.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Ports of the optional Jaeger trace viewer (docker compose --profile tracing up -d).
JAEGER_UI_PORT=16686
OTLP_PORT=4318

# Feature switches, as in deployed environments. Sharing documents for signature is off by
# default, and plan limits are enforced unless switched off for testing.
# DOCUMENT_SHARING_ENABLED=false
# TIER_LOCKS_ENABLED=true
